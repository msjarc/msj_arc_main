---
import Logo from './Logo.astro'
import themeConfig from '@theme-config'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear()
---

<footer>
  <section class="py-20">
    <Heading level="h2" class="sr-only">Footer</Heading>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Club</Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="/">Home</Link></li>
          <li><Link href="/about">About Us</Link></li>
          <li><Link href="/newham">New Ham?</Link></li>
          <li><Link href="/blog">Blog</Link></li>
          <li><Link href="/contact">Contact</Link></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Resources</Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="/calendars">Calendars</Link></li>
          <li><Link href="/clubs">Local Clubs</Link></li>
          <li><Link href="/nets">Local Nets</Link></li>
          <li><Link href="/repeaters">Local Repeaters</Link></li>
          <li><Link href="/materials">Presentations &amp; Reference Materials</Link></li>
          <li><Link href="/misc">Miscellaneous</Link></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Get in touch</Heading>
        <ul class="flex flex-col gap-2">
          <li>
            <span class="font-bold">Email:</span>
            <Link href="mailto:w6msj@msjarc.org">w6msj@msjarc.org</Link>
          </li>
          <li>
            <span class="font-bold">Phone:</span>
            <Link href="tel:+16692230212">+1 (669) 223-0212</Link>
          </li>
          <li>MSJ ARC, 41717 Palm Avenue, Fremont, CA 94539</li>
        </ul>
        <ul class="flex flex-wrap gap-3">
          {
            themeConfig.socials?.map((social) => (
              <li>
                <Link href={social.href} isButton isExternal hideIcon animateOnHover animationType="boop">
                  <Icon aria-hidden="true" name={social.icon} size={28} />
                  <span class="sr-only">{social.label}</span>
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Logo loading="lazy" />
        <p class="leading-[1.75]">
          Mission San Jose High School Amateur Radio Club - MSJ ARC; call sign <strong>W6MSJ</strong>. Sharing the joy
          of the hobby with our school and the local community.
        </p>
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} - MSJ Amateur Radio Club.
      </p>
      <p></p>
      <p>
        Built with <Link href="https://astro.build/">Astro's</Link>
        <Link href="https://accessible-astro-starter.incluud.dev/">Accessible Starter Template.</Link> Domain generously provided
        by <Link href="https://porkbun.com/">Porkbun!</Link>
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
