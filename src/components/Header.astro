---
import Navigation from '@components/Navigation.astro'
import LauncherConfig from '@components/LauncherConfig.astro'
import { HighContrast, Notification, ReducedMotion, SkipLink } from 'accessible-astro-components'

/**
 * Header Component
 *
 * @description A component that displays the header of the website
 */
---

<header>
  <SkipLink />
  <!-- Initialize preference components -->
  <div hidden>
    <HighContrast />
    <ReducedMotion />
  </div>

  <Navigation />
  {/* To remove the launcher, delete this component and remove the LauncherTrigger from `Navigation.astro`. */}
  <LauncherConfig />
  <div class="mx-8 lg:mx-0">
    <Notification type="info" variant="accent" role="status" class="container my-2">
      <p><strong>Website under construction</strong> - Updates are coming VERY soon, we promise ;)</p>
    </Notification>
  </div>
</header>

<style lang="scss" is:global>
  @use '@assets/scss/base/breakpoint' as *;

  header {
    li.type-icon {
      display: block;

      @include breakpoint('nav') {
        translate: 0 4px;
      }

      button {
        border: none;
        border-radius: 0;
      }

      svg {
        inline-size: 30px;
        block-size: 30px;
      }
    }

    li.type-icon ~ li.type-icon {
      @include breakpoint('nav') {
        margin-inline-start: calc(var(--space-2xs) * -1);
      }
    }

    li.desktop-launcher {
      display: none;
    }

    @include breakpoint('nav') {
      li.desktop-launcher {
        display: block;
      }
    }

    // Recolor the Ctrl+K launcher's animated gradient border to match the
    // quick-link buttons on the homepage (looping A -> B -> A for a seamless
    // hover animation). The animation itself is kept from the launcher package.
    .launcher-trigger.gradient-border .trigger {
      background: linear-gradient(
        115deg,
        light-dark(var(--color-primary-300), var(--color-secondary-100)),
        light-dark(var(--color-secondary-300), var(--color-primary-200)),
        light-dark(var(--color-primary-300), var(--color-secondary-100))
      );
      background-size: 200% 100%;
    }
  }
</style>
