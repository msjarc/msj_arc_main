---
import { Modal, Link, Button } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Discord Modal Component
 *
 * @description Premade modal to confirm users are students before showing discord invite.
 * Place once in the site header. Any element with `data-discord-modal` will open it.
 */

interface Props {
  /**
   * ID of the hidden button the modal library binds to
   */
  modalTriggerId?: string
}

const { modalTriggerId = 'discord-modal-trigger' }: Props = Astro.props
---

<button type="button" id={modalTriggerId} hidden>Join Discord</button>

<Modal triggerId={modalTriggerId} title="Join our Discord">
  <p>
    To protect student privacy, we ask that only current or future Mission San Jose High School students join our
    Discord server.
  </p>

  <Link
    href="https://discord.gg/AWxKMAzbCm"
    isExternal
    isButton
    class="button-gradient"
    ariaLabel="Discord server invite for students"
  >
    <Icon name="ion:logo-discord" />
    Discord Invite
  </Link>

  <Button onclick="closeModal()" variant="outlined">Close</Button>
</Modal>

<script>
  document.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null
    if (!target?.closest('[data-discord-modal]')) return

    event.preventDefault()
    document.getElementById('discord-modal-trigger')?.click()
  })
</script>
