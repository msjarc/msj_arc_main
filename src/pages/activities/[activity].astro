---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading } from 'accessible-astro-components'
import { getCollection, getEntry, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const activities = await getCollection('activities')

  return activities.map((activity) => ({
    params: { activity: activity.id },
    props: { activity },
  }))
}

interface Props {
  activity: CollectionEntry<'activities'>
}

const { activity } = Astro.props
const { Content } = await render(activity)

const authorEntry = await getEntry(activity.data.author)

if (!authorEntry) {
  throw new Error(`Missing author "${activity.data.author.id}" for activity "${activity.id}"`)
}

const author = {
  name: authorEntry.data.title,
  image: authorEntry.data.image || '/projects/project-image-1.png',
  bio: authorEntry.data.bio || 'A pretty cool guy, probably',
}
---

<DefaultLayout
  title={activity.data.title}
  description={activity.data.description}
  url={`/activities/${activity.id}`}
  image={activity.data.cover}
>
  <PageHeader
    title={activity.data.title}
    subtitle={activity.data.description}
    author={author}
    bgType="bordered"
    featuredImage={activity.data.cover}
    featuredImageAlt={activity.data.coverAlt}
    coverFocus={activity.data.coverFocus}
  />
  <section class="my-12">
    <div class="narrow space-content container">
      <Content />
    </div>
  </section>
  <section class="my-12">
    <div class="narrow space-content container">
      <Heading level="h2">Share this activity</Heading>
      <p>Like this activity? Share it with your friends!</p>
      <SocialShares />
    </div>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  .narrow {
    margin-inline: auto;
    max-width: 65ch;
  }
</style>
