---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Badge, Card, Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { slugify } from '@utils/slugify'
import { getCoverProps } from '@utils/coverImage'

export const getStaticPaths = (async ({ paginate }) => {
  const activities = await getCollection('activities')
  const authors = await getCollection('authors')
  const allTags = activities.map((activity) => activity.data.tags).flat()
  const uniqueTagLabels = [...new Set(allTags)].sort((a, b) => a.localeCompare(b))
  const uniqueTags = uniqueTagLabels.map((label) => ({
    label,
    slug: slugify(label),
  }))

  const activitiesWithAuthors = activities.map((activity) => {
    return {
      ...activity,
      authorName: authors.find((a) => a.id === activity.data.author.id)?.data.title,
    }
  })

  return paginate(activitiesWithAuthors, {
    pageSize: 6,
    props: { uniqueTags },
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'activities'> & { authorName: string | undefined }>
  uniqueTags: { label: string; slug: string }[]
}

const { page, uniqueTags } = Astro.props
---

<DefaultLayout title="Activities" description="An overview of some activities within amateur radio.">
  <PageHeader title="Activities" subtitle="An overview of some activities within amateur radio." bgType="bordered" />
  <section class="my-12">
    <div class="container">
      <Heading level="h2" size="h5" class="mb-2">Tags</Heading>
      <div class="flex flex-wrap gap-4">
        {
          uniqueTags.map((tag: { label: string; slug: string }) => (
            <Link href={'/activities/tag/' + tag.slug}>{tag.label}</Link>
          ))
        }
      </div>
      <p class="mt-8 text-sm">
        <em>Activity {page.start + 1} through {page.end + 1} of {page.total} total activities</em>
      </p>
      <ul class="mt-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((activity) => {
            const cover = getCoverProps(activity.data)
            return (
              <li>
                <Card
                  imageComponent={cover.src}
                  imageAlt={cover.alt}
                  width={cover.width}
                  height={cover.height}
                  style={cover.style}
                  url={'/activities/' + activity.id}
                  title={activity.data.title}
                  headingLevel="h2"
                  footer={'Author: ' + activity.authorName}
                  fullHeight={true}
                >
                  <span slot="meta">
                    {activity.data.tags.map((tag: unknown) => (
                      <Badge>{tag}</Badge>
                    ))}
                  </span>
                  {activity.data.description}
                </Card>
              </li>
            )
          })
        }
      </ul>
      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? '/activities' : null}
              previousPage={page.url.prev ? page.url.prev : null}
              nextPage={page.url.next ? page.url.next : null}
              lastPage={page.url.next ? `/activities/${page.lastPage}` : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel="Activities pagination"
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>
