---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Link } from 'accessible-astro-components'
---

<DefaultLayout title="Local Repeaters">
  <PageHeader
    title="Local Repeaters"
    subtitle="Repeaters extend the range of your handheld or mobile radio across the area."
    bgType="bordered"
  />

  <section class="container my-16 space-content">
    <p class="text-2xl">
      A <strong>repeater</strong> receives your signal and re-transmits it at higher power from a better location,
      dramatically extending how far you can be heard on VHF/UHF. To use one, program your radio with its output
      frequency, offset, and access tone (CTCSS/PL).
    </p>
    <p class="text-sm">
      The table below shows the format only. Always verify a repeater&rsquo;s current frequency, offset, and tone on
      <Link isExternal href="https://www.repeaterbook.com">RepeaterBook</Link> before use.
    </p>
  </section>

  <section class="container my-16 space-content">
    <Heading level="h2">Repeater list</Heading>
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Local amateur radio repeaters</caption>
        <thead>
          <tr>
            <th scope="col">Location / Name</th>
            <th scope="col">Output (MHz)</th>
            <th scope="col">Offset</th>
            <th scope="col">Tone (PL)</th>
            <th scope="col">Band</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Example 2m repeater</td>
            <td>146.xxx</td>
            <td>&minus; 0.6 MHz</td>
            <td>100.0 Hz</td>
            <td>2m (VHF)</td>
          </tr>
          <tr>
            <td>Example 70cm repeater</td>
            <td>44x.xxx</td>
            <td>+ 5.0 MHz</td>
            <td>100.0 Hz</td>
            <td>70cm (UHF)</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-sm">
      Standard offsets: 2m uses &plusmn;0.6 MHz, 70cm uses &plusmn;5.0 MHz. The access tone must match the repeater&rsquo;s
      requirement for it to hear you.
    </p>
  </section>

  <section class="container my-16 space-content">
    <Heading level="h2">Find repeaters near you</Heading>
    <ul class="space-content text-lg">
      <li><Link isExternal href="https://www.repeaterbook.com">RepeaterBook</Link> — searchable directory by location</li>
      <li><Link isExternal href="https://www.artscipub.com/repeaters/">The Repeater Directory</Link></li>
    </ul>
  </section>
</DefaultLayout>

<style>
  .table-wrap {
    overflow-x: auto;
  }

  table {
    inline-size: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: var(--space-2xs) var(--space-xs);
    border-bottom: 1px solid var(--border-color-subtle);
    text-align: start;
  }

  th {
    font-weight: 700;
  }
</style>
