---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="Local Clubs">
  <PageHeader
    title="Local Clubs"
    subtitle="Amateur radio clubs and organizations in the Bay Area and beyond."
    bgType="bordered"
  />

  <section class="container my-16 space-content">
    <p class="text-2xl">
      One of the best ways to grow in amateur radio is to connect with other clubs. Below are ways to find clubs near
      Fremont and across the country.
    </p>
  </section>

  <section class="container my-16 space-content">
    <Heading level="h2">Find a club near you</Heading>
    <ul class="space-content text-lg">
      <li>
        <Link isExternal href="https://www.arrl.org/find-a-club">ARRL Club Finder</Link> — search the national database of
        affiliated clubs by location
      </li>
      <li>
        <Link isExternal href="https://www.arrl.org/sections">ARRL Sections</Link> — our area is part of the ARRL Pacific
        Division, East Bay Section
      </li>
    </ul>
  </section>

  <section class="container my-16 space-content">
    <Heading level="h2">National organizations</Heading>
    <ul class="space-content text-lg">
      <li>
        <Link isExternal href="https://www.arrl.org">ARRL</Link> — the national association for amateur radio in the U.S.
      </li>
      <li>
        <Link isExternal href="https://www.amsat.org">AMSAT</Link> — amateur radio in space and satellite operation
      </li>
      <li>
        <Link isExternal href="https://www.tapr.org">TAPR</Link> — amateur digital and experimental communications
      </li>
    </ul>
  </section>

  <section class="container my-16 space-content">
    <div class="flex flex-wrap gap-4">
      <Link href="/nets" isButton type="secondary" class="button-gradient" animateOnHover animationType="boop">
        <Icon aria-hidden="true" name="lucide:mic" size="1.5rem" />
        Local nets
      </Link>
      <Link href="/repeaters" isButton type="secondary" class="button-gradient" animateOnHover animationType="boop">
        <Icon aria-hidden="true" name="lucide:radio-tower" size="1.5rem" />
        Local repeaters
      </Link>
    </div>
  </section>
</DefaultLayout>
