---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Link } from 'accessible-astro-components'
---

<DefaultLayout title="Presentations & Reference Materials">
  <PageHeader
    title="Presentations & Reference Materials"
    subtitle="Slides, guides, and references from the club and the wider amateur radio community."
    bgType="bordered"
  />

  <section class="container my-16 space-content">
    <Heading level="h2">Club presentations</Heading>
    <p class="text-lg">
      Slides and handouts from our meetings and workshops will be posted here as they become available.
    </p>
  </section>

  <section class="container my-16 space-content">
    <Heading level="h2">Reference materials</Heading>
    <div class="mt-4 grid grid-cols-1 gap-12 md:grid-cols-2">
      <div class="space-content">
        <Heading level="h3" size="h5">Operating references</Heading>
        <ul class="space-content">
          <li>
            <Link isExternal href="https://www.arrl.org/files/file/Regulatory/Band%20Chart/Band%20Chart%2011X17%20Color.pdf"
              >ARRL U.S. Amateur Radio Band Chart</Link
            >
          </li>
          <li>
            <Link isExternal href="https://www.arrl.org/band-plan">ARRL Band Plan</Link>
          </li>
          <li>
            <Link isExternal href="https://www.arrl.org/phonetics">ITU Phonetic Alphabet</Link>
          </li>
          <li>
            <Link isExternal href="https://www.arrl.org/q-signals">Common Q-Signals</Link>
          </li>
        </ul>
      </div>
      <div class="space-content">
        <Heading level="h3" size="h5">Learning &amp; rules</Heading>
        <ul class="space-content">
          <li>
            <Link isExternal href="https://www.arrl.org/getting-licensed">Getting Licensed (ARRL)</Link>
          </li>
          <li>
            <Link isExternal href="https://hamstudy.org">HamStudy.org practice exams</Link>
          </li>
          <li>
            <Link isExternal href="https://www.ecfr.gov/current/title-47/chapter-I/subchapter-D/part-97"
              >FCC Part 97 — Amateur Radio rules</Link
            >
          </li>
          <li>
            <Link isExternal href="https://www.fcc.gov/wireless/universal-licensing-system">FCC ULS license lookup</Link>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container my-16 space-content">
    <Heading level="h2">More resources</Heading>
    <ul class="space-content text-lg">
      <li><Link href="/newham">New to ham radio? Start here.</Link></li>
      <li><Link href="/repeaters">Local repeaters</Link></li>
      <li><Link href="/misc">Miscellaneous</Link></li>
    </ul>
  </section>
</DefaultLayout>
