---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Notification } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import { getNewHamSteps } from '@utils/newHamSteps'

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const activities = await getCollection('activities')
const authors = await getCollection('authors')
const newhamSteps = await getNewHamSteps()

const authorName = (authorId: string) => authors.find((author) => author.id === authorId)?.data.title ?? authorId

const staticPages = [
  {
    title: 'Home',
    url: '/',
    description: 'The one, the only, Mission San Jose High School Amateur Radio Club, W6MSJ!',
  },
  {
    title: 'About Us',
    url: '/about',
    description: 'Learn about what we do',
  },
  {
    title: 'Blog',
    url: '/blog',
    description: 'Rants, ramblings, and other texts of mysterious origin',
  },
  {
    title: 'Activities',
    url: '/activities',
    description: 'An overview of some activities within amateur radio',
  },
  {
    title: 'New Ham?',
    url: '/newham',
    description: 'Get started with amateur radio and getting your license',
  },
  ...newhamSteps.map((step) => ({
    title: step.title,
    url: step.href,
    description: step.description,
  })),
  {
    title: 'Calendars',
    url: '/calendars',
    description: 'Calendars for club meetings, events, and other important dates',
  },
  {
    title: 'Local Clubs',
    url: '/clubs',
    description: 'Other amateur radio clubs in the area',
  },
  {
    title: 'Local Nets',
    url: '/nets',
    description: 'Local nets in the Bay Area',
  },
  {
    title: 'Local Repeaters',
    url: '/repeaters',
    description: 'Repeaters in the Bay Area',
  },
  {
    title: 'Presentations & Reference Materials',
    url: '/materials',
    description: 'Various club materials, including slideshows and such',
  },
  {
    title: 'Miscellaneous',
    url: '/misc',
    description: 'Miscallenous goodies',
  },
  {
    title: 'Contact',
    url: '/contact',
    description: 'Get in touch with us',
  },
]
---

<DefaultLayout
  title="Sitemap"
  description="Complete site map"
>
  <PageHeader
    title="Sitemap"
    bgType="gradient"
  />

  <section class="my-16">
    <div class="container space-y-12">
      <div>
        <Heading level="h2" class="mb-6">Main pages</Heading>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            staticPages.map((page) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={page.url}>{page.title}</a>
                </Heading>
                <p class="mb-3">{page.description}</p>
                <p class="text-xs">
                  URL:{' '}
                  <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                    {page.url}
                  </code>
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <Heading level="h2">Activities</Heading>
        <p class="mb-6">Descriptions and intros to a variety amateur radio activities</p>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            activities.map((activity) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={`/activities/${activity.id}`}>{activity.data.title}</a>
                </Heading>
                <p class="mb-3">{activity.data.description}</p>
                <div class="text-xs">
                  <p class="mb-1">
                    By: <span class="font-medium">{authorName(activity.data.author.id)}</span>
                  </p>
                  <p>
                    URL:{' '}
                    <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                      /activities/{activity.id}
                    </code>
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <Heading level="h2" class="mb-6">Blog</Heading>
        <p class="mb-6">Take a look at any of our {posts.length} posts. Guaranteed mildly interesting.</p>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            posts.map((post) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </Heading>
                <p class="mb-3">{post.data.description}</p>
                <div class="text-xs">
                  <p class="mb-1">
                    By: <span class="font-medium">{authorName(post.data.author.id)}</span>
                  </p>
                  <p>
                    URL:{' '}
                    <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                      /blog/{post.id}
                    </code>
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <Notification type="info" variant="accent">
        <div class="space-content">
          <Heading level="h2" size="h6" class="mb-4">Technical sitemap information</Heading>
          <ul>
            <li>
              <span class="font-bold">XML Sitemap:</span> An automated XML sitemap is generated at
              <code>/sitemap.xml</code>
              for search engine optimization.
            </li>
            <li>
              <strong>Generated by:</strong> @astrojs/sitemap integration configured in astro.config.mjs
            </li>
            <li>
              <strong>Last updated:</strong> Automatically updated on each build
            </li>
          </ul>
        </div>
      </Notification>
    </div>
  </section>
</DefaultLayout>

<style>
  article {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-large);
    background-color: var(--background-color);
    padding: 1rem;
  }
</style>
