---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import NextMeeting from '@components/NextMeeting.astro'
import FeaturedPosts from '@components/FeaturedPosts.astro'
import ContentMedia from '@components/ContentMedia.astro'
import { Link } from 'accessible-astro-components'
import CallToAction from '@components/CallToAction.astro'
import { Heading, Media } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { Tabs, TabsList, TabsTab, TabsPanel } from 'accessible-astro-components'
---

<DefaultLayout title="MSJ Amateur Radio Club" useTitleTemplate={false}>
  <Hero src="/hero1%20cropped.png" />

  <section class="quick-links container mb-16">
    <hr class="hero-divider mb-16" />
    <Heading level="h2" class="mb-8">Quick Links</Heading>
    <ul class="quick-link-cards grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
      <li>
        <a href="/newham" class="quick-link-card">
          <Feature icon="lucide:graduation-cap" title="New Ham?">
            New to amateur radio? Start here and get licensed.
          </Feature>
        </a>
      </li>
      <li>
        <a href="/calendars" class="quick-link-card">
          <Feature icon="lucide:calendar-days" title="Calendars"> Club meetings, events, and important dates. </Feature>
        </a>
      </li>
      <li>
        <a href="/repeaters" class="quick-link-card">
          <Feature icon="lucide:radio-tower" title="Local Repeaters">
            Find local repeaters to extend your range.
          </Feature>
        </a>
      </li>
      <li>
        <a href="/blog" class="quick-link-card">
          <Feature icon="lucide:newspaper" title="Blog"> News and updates from the club. </Feature>
        </a>
      </li>
      <li>
        <a href="/contact" class="quick-link-card">
          <Feature icon="lucide:mail" title="Contact"> Have a question? Get in touch with us. </Feature>
        </a>
      </li>
    </ul>
  </section>

  <ContentMedia imgSrc="/msjhs_map_arc_annotated.jpg">
    <Heading level="h2">Meetings</Heading>
    <p class="text-2xl">
      We hold meetings every other Monday in E1A during lunch (Ms. Kim's room, previously Mr. Sale's room).
    </p>
    <!-- <p class="text-2xl">Note: we don't hold meetings in E2B anymore, as Ms. Kim switched classrooms.</p> -->

    <NextMeeting />

    <Link isButton class="button-gradient" href="/calendars"><Icon name="ion:calendar-outline" />Meeting Schedule</Link>
  </ContentMedia>

  <FeaturedPosts />

  <section class="my-64">
    <div class="media-wrapper container">
      <picture>
        <source srcset="https://www.hamqsl.com/solar101vhfpic.php" media="(orientation: landscape)" />
        <source srcset="https://www.hamqsl.com/solarn0nbh.php" media="(orientation: portrait)" />

        <img
          src="https://www.hamqsl.com/solar101vhfpic.php"
          alt="Solar and amateur radio band data from https://www.hamqsl.com"
          loading="lazy"
        />
      </picture>

      <!-- <Media
        src="https://www.hamqsl.com/solar101vhfpic.php"
        alt="Solar and amateur radio band data from https://www.hamqsl.com"
      /> -->
    </div>
  </section>

  <CallToAction />
</DefaultLayout>

<style>
  .hero-divider {
    border: none;
    border-top: 2px solid var(--border-color);
  }

  /* Quick links as clickable Feature-style cards (mirrors the old Features grid) */
  .quick-link-cards {
    padding: 0;
    list-style: none;
  }

  .quick-link-card {
    display: block;
    block-size: 100%;
    color: var(--foreground-color);
    text-decoration: none;
  }

  .quick-link-card :global(.feature) {
    block-size: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .quick-link-card {
      transition: translate var(--animation-speed-fast) var(--cubic-bezier);
    }

    .quick-link-card:where(:hover, :focus-visible) {
      translate: 0 -4px;
    }
  }

  :where(.media-wrapper) {
    position: relative;
    border-radius: 0.5rem;
    inline-size: 100%;
    overflow: hidden;
  }

  :where(.media-wrapper img) {
    border-radius: inherit;
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
  }
</style>
