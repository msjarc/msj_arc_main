---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Badge, Card, Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { slugify } from '@utils/slugify'
import { getCoverProps } from '@utils/coverImage'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  const authors = await getCollection('authors')
  const allTags = posts.map((post) => post.data.tags).flat()
  const uniqueTagLabels = [...new Set(allTags)].sort((a, b) => a.localeCompare(b))
  const uniqueTags = uniqueTagLabels.map((label) => ({
    label,
    slug: slugify(label),
  }))

  const postsWithAuthors = posts.map((post) => {
    return {
      ...post,
      authorName: authors.find((a) => a.id === post.data.author.id)?.data.title,
    }
  })

  return paginate(postsWithAuthors, {
    pageSize: 6,
    props: { uniqueTags },
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'> & { authorName: string | undefined }>
  uniqueTags: { label: string; slug: string }[]
}

const { page, uniqueTags } = Astro.props
---

<DefaultLayout title="Blog" description="MSJ Amateur Radio Club's blog">
  <PageHeader
    title="Blog"
    subtitle="Only the finest collection of rants and ramblings, from the staff here at MSJ ARC"
    bgType="bordered"
  />
  <section class="my-12">
    <div class="container">
      <Heading level="h2" size="h5" class="mb-2">Tags</Heading>
      <div class="flex flex-wrap gap-4">
        {
          uniqueTags.map((tag: { label: string; slug: string }) => (
            <Link href={'/blog/tag/' + tag.slug}>{tag.label}</Link>
          ))
        }
      </div>
      <p class="mt-8 text-sm">
        <em>Post {page.start + 1} through {page.end + 1} of {page.total} total posts</em>
      </p>
      <ul class="mt-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((post) => {
            const cover = getCoverProps(post.data)
            return (
              <li>
                <Card
                  imageComponent={cover.src}
                  imageAlt={cover.alt}
                  width={cover.width}
                  height={cover.height}
                  style={cover.style}
                  url={'/blog/' + post.id}
                  title={post.data.title}
                  headingLevel="h2"
                  footer={'Author: ' + post.authorName}
                  fullHeight={true}
                >
                  <span slot="meta">
                    {post.data.tags.map((tag: unknown) => (
                      <Badge>{tag}</Badge>
                    ))}
                  </span>
                  {post.data.description}
                </Card>
              </li>
            )
          })
        }
      </ul>
      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? '/blog' : null}
              previousPage={page.url.prev ? page.url.prev : null}
              nextPage={page.url.next ? page.url.next : null}
              lastPage={page.url.next ? `/blog/${page.lastPage}` : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel="Blog pagination"
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>
