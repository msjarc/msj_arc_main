---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading } from 'accessible-astro-components'
import { getCollection, getEntry, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

  return posts.map((post) => ({
    params: { post: post.id },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)

const authorEntry = await getEntry(post.data.author)

if (!authorEntry) {
  throw new Error(`Missing author "${post.data.author.id}" for post "${post.id}"`)
}

const author = {
  name: authorEntry.data.title,
  image: authorEntry.data.image || '/projects/project-image-1.png',
  bio: authorEntry.data.bio || 'A pretty cool guy, probably',
}
---

<DefaultLayout
  title={post.data.title}
  description={post.data.description}
  url={`/blog/${post.id}`}
  image={post.data.cover}
>
  <PageHeader
    title={post.data.title}
    subtitle={post.data.description}
    author={author}
    bgType="bordered"
    featuredImage={post.data.cover}
    featuredImageAlt={post.data.coverAlt}
    coverFocus={post.data.coverFocus}
  />
  <section class="my-12">
    <div class="narrow space-content container">
      <Content />
    </div>
  </section>
  <section class="my-12">
    <div class="narrow space-content container">
      <Heading level="h2">Share this post</Heading>
      <p>Like this post? Share it with your friends!</p>
      <SocialShares />
    </div>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  .narrow {
    margin-inline: auto;
    max-width: 65ch;
  }
</style>
