---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading } from 'accessible-astro-components'
import { getCollection, getEntries, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { getEntry } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')

  const postImages = [
    { src: '/projects/project-image-1.png' },
    { src: '/projects/project-image-2.png' },
    { src: '/projects/project-image-3.png' },
    { src: '/projects/project-image-4.png' },
    { src: '/projects/project-image-5.png' },
    { src: '/projects/project-image-6.png' },
  ]

  function truncateTitle(title: string) {
    const words = title.split(' ')
    const truncated = words.slice(0, 4).join(' ')
    return {
      full: title,
      truncated: truncated,
    }
  }

  return posts.map((post, index) => {
    const titleObj = truncateTitle(post.data.title)

    const postWithImage = {
      ...post,
      featuredImage: postImages[index % postImages.length].src,
      title: titleObj.truncated,
    }

    return {
      params: { post: post.id },
      props: { post: postWithImage },
    }
  })
}

interface Props {
  post: CollectionEntry<'blog'> & { featuredImage: string }
}

const { post } = Astro.props
const { Content } = await render(post)

const authorEntry = await getEntry(post.data.author)

console.log(authorEntry)

const author = {
  name: authorEntry.data.title,
  // image: authorEntry.data.image,
  image: authorEntry.data.image || '/projects/project-image-1.png',
  bio: authorEntry.data.bio || 'A pretty cool guy, probably',
}

console.log('author name: ' + authorEntry.data.image)
---

<DefaultLayout title={post.data.title} description={post.data.description} url={`/portfolio/${post.id}`}>
  <PageHeader
    title={post.data.title}
    subtitle={post.data.description}
    author={author}
    bgType="bordered"
    featuredImage={post.featuredImage}
  />
  <section class="my-12">
    <div class="narrow space-content container">
      <Content />
    </div>
  </section>
  <section class="my-12">
    <div class="narrow space-content container">
      <Heading level="h2">Share this post</Heading>
      <p>Like this post? Share it with your friends!</p>
      <SocialShares />
    </div>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  .narrow {
    margin-inline: auto;
    max-width: 65ch;
  }
</style>
