  <section class="container my-16">
    <Heading level="h4">Picture Credits</Heading>

    <p>
      <a href="https://commons.wikimedia.org/wiki/User:Alvesgaspar">Alvesgaspar</a>, <a
        href="https://commons.wikimedia.org/wiki/File:Cat_November_2010-1a.jpg">Cat November 2010-1a</a
